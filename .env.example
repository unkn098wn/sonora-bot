# Telegram Bot Token (from @BotFather)
SONORA_BOT_TOKEN=9127762870:AAHJXJL9EADvRAeTh8zdblhBbbjLxvBtPgU
SONORA_BOT_USERNAME=sonoramus1c_bot

# HTTP REST Gateway Port
PORT=8088

# ==============================================================================
# SMTP Email Settings (для отправки кодов подтверждения на Email)
# ==============================================================================
# Поддерживаются: Gmail, Yandex, Mail.ru, Rambler или любой кастомный SMTP.
#
# ДЛЯ GMAIL:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=ваша_почта@gmail.com
#   SMTP_PASSWORD=пароль_приложения_google (16 символов, создаётся в myaccount.google.com -> Безопасность -> Пароли приложений)
#
# ДЛЯ YANDEX:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_USER=ваша_почта@yandex.ru
#   SMTP_PASSWORD=пароль_приложений_яндекс (создаётся в id.yandex.ru -> Безопасность -> Пароли приложений)
#
# ДЛЯ MAIL.RU:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
#   SMTP_USER=ваша_почта@mail.ru
#   SMTP_PASSWORD=пароль_для_внешних_приложений (создаётся в account.mail.ru -> Безопасность -> Пароли для внешних приложений)
#
# Если пароль не указан, сервер работает в DEMO-режиме (коды пишутся в консоль сервера)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Sonora Music
SMTP_FROM_EMAIL=
